{
  "name": "sensmore-filedrop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "types": "wrangler types --strict-vars=false",
    "build": "esbuild src/client.ts --bundle --format=esm --target=es2022 --outdir=public/assets --minify",
    "dev": "bun run build && wrangler dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.12.32",
    "jose": "^6.2.12",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.8",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0",
    "vitest": "~4.1.0",
    "wrangler": "^4.143.1"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ]
}
