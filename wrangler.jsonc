{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "files",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "sensmore.cloudflareaccess.com",
    "ACCESS_AUD": "",
    "ALLOWED_EMAIL_DOMAIN": "sensmore.ai",
  },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "sensmore-filedrop" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sensmore-filedrop",
      "database_id": "local",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "LINK_LIMITER",
      "namespace_id": "73101",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
}
